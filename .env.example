# ══════════════════════════════════════════════════════════════
#  Copy this file to `.env` and fill it in.  `.env` is gitignored.
#     cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ── her ───────────────────────────────────────────────────────
USER_NAME=Priti
FROM_NAME=— me
BIRTH_DATE=2000-08-18


# ── HOW HER REPLY REACHES YOU ─────────────────────────────────
# Pick ONE of the two Telegram options below.

# ▸ OPTION A — PROXY  (recommended for anything you host publicly)
#   Your token lives on a Cloudflare Worker, never in the page.
#   Deploy worker/telegram-proxy.js, then paste its URL here.
#   This URL is safe to expose.
TELEGRAM_PROXY_URL=

# ▸ OPTION B — DIRECT  (fine for localhost / a private one-off link)
#   ⚠ These get baked into the built HTML and ARE readable by
#     anyone who views source on the deployed page. Use a throwaway
#     bot and /revoke it in BotFather once you have her reply.
#   token : @BotFather → /newbot
#   chatId: message your bot once, then open
#           https://api.telegram.org/bot<TOKEN>/getUpdates
#           and copy result[0].message.chat.id
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=


# ▸ OPTION C — FORMSUBMIT  (no account, no key, ~60 seconds)
#   Just your email. First send triggers a confirmation link you click
#   once. Delivers her note, her wish and the recording as an attachment.
FORMSUBMIT_EMAIL=

# ▸ OPTION D — WHATSAPP  (zero setup, always works)
#   Your number, country code, digits only. Opens WhatsApp with her
#   message already typed; she presses send.
WHATSAPP=

# opens her mail app instead (she presses send)
EMAIL=


# ── EmailJS (optional, text only — no attachments on free) ────
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
